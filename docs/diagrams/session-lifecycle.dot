digraph session_lifecycle {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.55,
    fontname="DejaVu Sans", fontsize=24, label="Session publication and local detachment", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#f0f6ff", color="#6986a8", fontcolor="#17253b", fontname="DejaVu Sans", fontsize=16, margin="0.18,0.14"];
  edge [color="#315e9b", fontcolor="#294666", fontname="DejaVu Sans", fontsize=13];
  issue [label="Issuer verifies identity and issues a pair\nImmutable subject, SessionId and gate catalog", fillcolor="#fff9ed"];
  live [label="Attached live session\nFresh snapshot(now) for each admission\nBase and temporary grants evaluated independently"];
  busy [label="Publication overlaps a read\nDeny this read; retain token\nNo token-side wait or retry", fillcolor="#fff9ed"];
  local [label="Local authority detached\nLogout, lock, timeout, subject / authenticator\nreplacement or fault quarantine", fillcolor="#fff0ef", color="#ae4242"];
  ended [label="Revoked / whole-session deadline reached\nDeny admission; shell drops reader\nNo renewal after expiry at issuer's clock", fillcolor="#fff0ef", color="#ae4242"];
  notify [label="Authenticator::session_ended(id, now)\nIssuer handles only the matching controller\nOther readers remain issuer-controlled", fillcolor="#fff9ed"];
  fresh [label="New login → new controller/token pair\nRevoked controllers cannot be reactivated"];
  issue -> live [label="correlated response accepted"];
  live -> live [label="replace_grants\nvalidate full set, publish new revision"];
  live -> busy [label="incoherent observation"];
  busy -> live [label="later coherent read"];
  live -> local [label="local end event"];
  live -> ended [label="controller revoke / Drop\nor observed expiry"];
  local -> notify [label="detach before notification"];
  ended -> notify [label="invalidate pending authentication"];
  notify -> fresh [style=dashed, label="when authentication is requested"];
  note [shape=note, fillcolor="#f7f7fa", label="A temporary grant expiry can remove one permission without ending the session.\nA concurrent revocation does not undo an operation already admitted.\nIndependent web and device login states require different pairs."];
  fresh -> note [style=invis];
}
